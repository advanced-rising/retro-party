{
  "name": "retro-party",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "contrast": "node --experimental-strip-types tools/contrast.ts",
    "typecheck": "tsc --build",
    "typecheck:clean": "tsc --build --clean && tsc --build",
    "test": "node --experimental-strip-types --test 'packages/**/src/**/*.test.ts' 'apps/web/src/lib/*.test.ts'",
    "smoke": "node --experimental-strip-types tools/smoke.ts",
    "bots": "node --experimental-strip-types tools/bots.ts"
  },
  "devDependencies": {
    "@types/node": "22",
    "typescript": "^5.7.3",
    "@retro/types": "workspace:*",
    "@retro/room-kit": "workspace:*",
    "@retro/game-chosung": "workspace:*",
    "@retro/game-geuhae": "workspace:*",
    "@retro/game-assoc": "workspace:*"
  }
}
