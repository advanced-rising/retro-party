{
  "name": "retro-party",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "contrast": "node --experimental-strip-types tools/contrast.ts",
    "typecheck": "tsc --build",
