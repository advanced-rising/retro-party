  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@retro/types": ["../../packages/types/src/index.ts"],
