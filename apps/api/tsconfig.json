{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "lib": [
      "ES2023"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "paths": {
      "@retro/types": [
        "../../packages/types/src/index.ts"
      ],
      "@retro/room-kit": [
        "../../packages/room-kit/src/index.ts"
      ],
      "@retro/game-chosung": [
        "../../packages/games/chosung/src/index.ts"
      ],
      "@retro/game-geuhae": [
        "../../packages/games/geuhae/src/index.ts"
      ],
      "@retro/game-assoc": [
        "../../packages/games/assoc/src/index.ts"
      ],
      "@retro/game-mulga": [
        "../../packages/games/mulga/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "worker-env.d.ts"
  ],
  "references": [
    {
      "path": "../../packages/types"
    },
    {
      "path": "../../packages/room-kit"
    },
    {
      "path": "../../packages/games/chosung"
    },
    {
      "path": "../../packages/games/geuhae"
    },
    {
      "path": "../../packages/games/assoc"
    },
    {
      "path": "../../packages/games/mulga"
    }
  ]
}
